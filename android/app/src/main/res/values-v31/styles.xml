<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 em diante desenha a abertura por conta própria: ignora o
     windowBackground e usa estes dois. Sem isso, a marca não apareceria nos
     celulares novos. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_marca</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
